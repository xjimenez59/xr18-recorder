[Unit]
Description=Enregistreur multipiste XR18 (interface web)
After=network.target local-fs.target sound.target

[Service]
Type=simple
User=xr18rec
Group=xr18rec
SupplementaryGroups=audio
WorkingDirectory=/opt/xr18rec/current
# En root (« + ») : copie les réglages déposés sur la partition de démarrage vers /etc après validation
ExecStartPre=+/usr/bin/python3 -m xr18rec bootconfig
ExecStart=/usr/bin/python3 -m xr18rec serve --config /etc/xr18rec.json
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
# Port 80 sans être root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
